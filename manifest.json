{
  "manifest_version": 3,
  "name": "Haiku (BeOS) Theme for Gmail",
  "version": "1.0.1",
  "description": "Make Gmail look and work like Haiku's BeMail: a BeOS-style toolbar, Tracker message list, yellow window tabs and Haiku controls.",
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "haiku.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "dev-content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.svg",
        "haiku.css"
      ],
      "matches": [
        "https://mail.google.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "dev-bg.js"
  },
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://mail.google.com/*"
  ],
  "icons": {
    "16": "icons/png/app-16.png",
    "32": "icons/png/app-32.png",
    "48": "icons/png/app-48.png",
    "128": "icons/png/app-128.png"
  }
}
